*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
coverage/
.coverage

# --- JS/TS test & build artifacts ---
*.tsbuildinfo
playwright-report/
test-results/
web/review-fix-artifacts/
.nyc_output/

# --- Tool/workspace state ---
.freebuff/

